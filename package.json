{
  "name": "belt-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "check": "pnpm -r --filter './packages/*' check",
    "ci": "pnpm lint && pnpm test && pnpm build",
    "lint": "pnpm check",
    "pack:belt": "pnpm --filter @riff-refine/belt pack:npm",
    "test": "vitest run",
    "test:backend": "vitest run"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.66",
    "@types/node": "^22.15.18",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "effect": "4.0.0-beta.66"
  }
}
