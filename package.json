{
  "name": "belt-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "check": "pnpm -r --filter './packages/*' check",
    "pack:belt": "pnpm --filter @riff-refine/belt pack:npm",
    "ci": "pnpm format:check && pnpm check && pnpm lint && pnpm test && pnpm build",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "pnpm lint:ox",
    "lint:fix": "oxlint . --fix",
    "lint:ox": "oxlint .",
    "test": "vitest run",
    "test:backend": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.0-beta.66"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.66",
    "@types/node": "^22.15.18",
    "oxfmt": "0.49.0",
    "oxlint": "1.64.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.11.0"
}
