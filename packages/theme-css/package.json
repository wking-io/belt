{
  "name": "@repo/theme-css",
  "version": "0.0.0",
  "private": true,
  "files": [
    "src"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "pnpm run build:css && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i ./src/theme.input.css -o ./dist/theme.css",
    "check": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "geist": "^1.7.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
