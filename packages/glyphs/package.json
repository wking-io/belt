{
  "name": "@repo/glyphs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "pnpm run build:glyphs && tsc -p tsconfig.build.json",
    "build:glyphs": "node scripts/generate-glyphs.mjs",
    "check": "pnpm run check:glyphs && tsc -p tsconfig.json",
    "check:glyphs": "node scripts/generate-glyphs.mjs --check"
  },
  "engines": {
    "node": ">=20"
  }
}
