    "@repo/core": "workspace:*",
    "@repo/renderer-remix": "workspace:*",
    "@repo/renderer-react": "workspace:*",
    "@repo/server": "workspace:*",
    "@repo/theme-css": "workspace:*",
    "@repo/tool-worktrees": "workspace:*",
    "@repo/tool-worktrees-extension-portless": "workspace:*",
    "@repo/tool-worktrees-renderer-remix": "workspace:*"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.66",
    "effect": "4.0.0-beta.66"
  },
  "engines": {
    "node": ">=20"
  }
